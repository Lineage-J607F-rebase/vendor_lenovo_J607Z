<?xml version="1.0" encoding="utf-8"?>
<!--
    VINTF fragment for com.qualcomm.qti.dpm.api@1.0 (dpmQmiMgr).
    Declares the HAL so hwservicemanager accepts registration; otherwise
    dpmQmiMgr fails with "Cannot find entry ... in VINTF manifest".

    Reference: ref/oops pmsg — dpmQmiMgr: "Failed to register as service".
-->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>com.qualcomm.qti.dpm.api</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IdpmQmi</name>
            <instance>dpmQmiService</instance>
        </interface>
        <fqname>@1.0::IdpmQmi/dpmQmiService</fqname>
    </hal>
</manifest>
